# Higgsfield API credentials for Merlin's video generation (server/higgsfield.js).
# Format: KEY_ID:KEY_SECRET — from your Higgsfield dashboard's API section.
# Copy this file to `.env` and fill in the real value; `.env` is gitignored.
HF_CREDENTIALS=

# Anthropic API key for the scriptwriting seat's cloud engine and Percival's
# fact-checking (server/anthropic.js). From your Anthropic Console's API Keys section.
ANTHROPIC_API_KEY=

# ElevenLabs API key for Miku's voiceover/music and Teto's sound effects
# (server/elevenlabs.js). From your ElevenLabs account's API Keys section.
ELEVENLABS_API_KEY=
# Optional: override the default voice ("Rachel") Miku uses for voiceover.
ELEVENLABS_VOICE_ID=

# Path to the Hermes Agent CLI executable (server/hermes.js) — Hermes's local,
# unrestricted engine. Defaults to "hermes" (relies on PATH); set this if it's
# only installed inside a venv, e.g. the venv's Scripts/hermes.exe (Windows) or
# bin/hermes (macOS/Linux). Requires a local Hermes Agent install configured
# with a model — see CLAUDE.md.
HERMES_BIN=
# Optional: working directory Hermes runs from (defaults to your home folder —
# deliberately NOT this repo, since Hermes has full file access).
HERMES_CWD=
